# LLM Model
LLM_MODEL=qwen/qwen3.6-35b-a3b # You'll want something that can handle images and call tools

# Ports
SEARXNG_PORT=9999 # Just the port I used to get it out of the way of other things
API_PORT=8091 # The port the API will run on
MCP_SERVER_ADDRESS=:8090 # Only a port since it runs on the same machine as the bot

# Endpoints
SEARXNG_URL=
FETCHER_MCP_ENDPOINT=
MCP_URL=http://localhost:8090/mcp # This is the address of the MCP server that is being hosted by the application
WEB_ORIGIN=http://localhost:5173
LLM_URL=http://localhost:1234/v1 # This is the case for LM Studio. Ollama or any other OpenAI compatible API will work.
VITE_API_BASE_DEV=http://localhost:8091/api # Frontend API base for bun dev / scripts/dev.sh
VITE_API_BASE=/api # Frontend API base for built UI (Docker/default same-origin)

# Max Upload and Image Bytes
VITE_MAX_UPLOAD_BYTES=31457280 # 30MB
VITE_MAX_IMAGE_BYTES=15728640 # 15MB

# Chat Token Maximum
VITE_MAX_TOKEN_COUNT=120000

# Auth
JWT_TOKEN=change-me-to-a-long-random-string # Signs short-lived access JWTs
JWT_REFRESH_TOKEN=change-me-too-different-string # Hashes refresh tokens at rest
DISABLE_AUTH=false # When true, all requests are auto-authenticated as the ROOT user (single-user dev mode)
ROOT_USERNAME=root # Default seeded admin account; remove or rotate before deploying
ROOT_PASSWORD=abc123 # Insecure default — change before deployment
COOKIE_SECURE=false # Set true when serving over HTTPS so cookies require TLS

# Storage (paths relative to api/ when running air or go from api/)
SQLITE_PATH=../.relay/data/relay.db